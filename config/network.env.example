# Interface roles. Must be distinct Linux interface names.
UPLINK_IF=eth0
CLIENT_IF=eth1

# Local Tor listeners.
TRANS_PORT=9040
DNS_PORT=5353
SOCKS_PORT=9050

# Tor service account on Raspberry Pi OS/Debian.
TOR_USER=debian-tor

# Interfaces whose MAC is randomized before the network starts.
# Defaults to both role interfaces when unset.
#MAC_IFACES=eth0 eth1

# Bounded retry for slow device enumeration. USB-Ethernet adapters on a
# headless Pi routinely appear after the unit has already started. Raise this
# if an adapter enumerates late; never work around it by weakening the
# dependency graph.
IFACE_WAIT_SECONDS=20

# Post-Tor probe targets. Used only by `amnesic-pi-anon verify-tor-path`,
# after Tor has bootstrapped.
TOR_PROBE_HOST=check.torproject.org
TOR_PROBE_PORT=443
TOR_DNS_PROBE_NAME=check.torproject.org

# Optional observational telemetry: an HTTP echo service fetched through Tor
# that reports the exit-observed address. Leave EMPTY for normal operation.
#
# This is NOT a security gate. An unreachable echo service is an outage, not
# proof of a clearnet leak, and never blocks readiness. It fails hard only if
# it reports an address belonging to this appliance.
#EGRESS_ECHO_HOST=
#EGRESS_ECHO_PATH=/
