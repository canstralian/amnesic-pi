[Unit]
Description=Amnesic Pi fail-closed firewall
DefaultDependencies=no
After=local-fs.target
Before=systemd-sysctl.service network-pre.target NetworkManager.service tor@default.service tor.service
Wants=network-pre.target
OnFailure=amnesic-pi-firewall-failure.service
RefuseManualStop=yes

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/amnesic-pi-firewall
ExecStartPost=/usr/local/bin/amnesic-pi verify-firewall
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
RequiredBy=NetworkManager.service
